{
  "name": "jurnal-guru-desktop",
  "version": "1.0.0",
  "description": "Aplikasi Desktop Resmi Jurnal Guru Digital & Kurikulum Merdeka (Windows & Linux Edition)",
  "homepage": "https://github.com/anugrahamanu/jurnal-guru-desktop",
  "main": "main.js",
  "author": "Anugrah Amanu Pratama <anugrahmanu885@gmail.com>",
  "license": "ISC",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "build:portable": "electron-builder --win portable",
    "build:installer": "electron-builder --win nsis",
    "build:linux": "electron-builder --linux tar.gz zip AppImage deb",
    "dist:win": "electron-builder --win",
    "dist:linux": "electron-builder --linux tar.gz zip AppImage deb",
    "dist": "electron-builder --win",
    "dist:all": "electron-builder --win --linux tar.gz zip"
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "id.my.gurugenz.desktop",
    "productName": "Jurnal Guru Digital",
    "copyright": "Copyright © 2026 Anugrah Amanu Pratama",
    "directories": {
      "output": "dist"
    },
    "asar": true,
    "extraResources": [
      {
        "from": "engine",
        "to": "engine"
      }
    ],
    "win": {
      "icon": "icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Jurnal Guru Digital"
    },
    "linux": {
      "icon": "icon.png",
      "target": [
        "AppImage",
        "deb",
        "tar.gz"
      ],
      "category": "Education",
      "synopsis": "Aplikasi Desktop Mandiri Jurnal Guru Digital & Kurikulum Merdeka",
      "description": "Aplikasi desktop mandiri offline untuk pengelolaan jurnal mengajar dan administrasi guru Kurikulum Merdeka.",
      "maintainer": "Anugrah Amanu Pratama <anugrahmanu885@gmail.com>"
    },
    "deb": {
      "priority": "optional",
      "depends": [
        "libgtk-3-0",
        "libnotify4",
        "libnss3",
        "libxss1",
        "xdg-utils"
      ]
    }
  }
}
